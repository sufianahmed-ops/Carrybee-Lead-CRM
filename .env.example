# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key_server_only

# Google Sheets migration + backup
GOOGLE_SERVICE_ACCOUNT_EMAIL=crm-backup@your-google-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SOURCE_SPREADSHEET_ID=existing_crm_sheet_id
GOOGLE_BACKUP_SPREADSHEET_ID=backup_sheet_id

# Protects scheduled/manual backup requests
CRON_SECRET=generate_a_long_random_value

# First admin invitation
ADMIN_EMAIL=admin@carrybee.com
ADMIN_NAME=CRM Admin
